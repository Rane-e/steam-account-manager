generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailAccount {
  uuid              String        @id @default(uuid())
  email             String        @unique
  password          String
  name              String
  surname           String?
  birthday          DateTime
  registration_date DateTime
  phone_number      String?
  reserve_email     String?
  other_data        Json?
  updated_at        DateTime      @updatedAt
  created_at        DateTime      @default(now())
  SteamAccount      SteamAccount?
}

model SteamAccount {
  uuid                        String       @id @default(uuid())
  email_uuid                  String       @unique
  login                       String       @unique
  password                    String
  phone_number                String?
  restriction_5dollar_removed Boolean
  steam_id64                  String?
  r_code                      String?
  maFile                      Json?
  isBanned                    Boolean
  created_at                  DateTime     @default(now())
  updated_at                  DateTime     @updatedAt
  emailAccount                EmailAccount @relation(fields: [email_uuid], references: [uuid])
}
